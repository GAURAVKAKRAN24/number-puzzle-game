[node name="Rule1" type="Label" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.93, 1, 1)
theme_override_font_sizes/font_size = 20
text = "1. Connect Matching Tiles
Drag across 2 or more adjacent tiles with the exact same number."
autowrap_mode = 3

[node name="Rule2" type="Label" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.93, 1, 1)
theme_override_font_sizes/font_size = 20
text = "2. Orthogonal Moves Only
You can connect horizontally or vertically. Diagonal connections are NOT allowed."
autowrap_mode = 3

[node name="Rule3" type="Label" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.93, 1, 1)
theme_override_font_sizes/font_size = 20
text = "3. Deterministic Merging
Tiles merge into the last tile you touched! Two 2s become a 4, two 4s become an 8, and longer chains double even higher!"
autowrap_mode = 3

[node name="Rule4" type="Label" parent="CenterContainer/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.93, 1, 1)
theme_override_font_sizes/font_size = 20
text = "4. Keep Space on the Board
New tiles spawn after every merge. If the 5x5 board fills with no matches left, the game is over!"
autowrap_mode = 3

